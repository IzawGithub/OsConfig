[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = "non-preview"
    hyperlinks = true
    line-numbers = true
    navigate = true
    syntax-theme = "Catppuccin Mocha"
[delta "preview"]
    side-by-side = false
[delta "non-preview"]
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[commit]
	gpgsign = true
[tag]
	gpgSign = true
[user]
	signingkey = 2D92B824540BBA1B
